# Base URL for the UI under test
UI_BASE_URL=https://practice.expandtesting.com

# Base URL for the Notes REST API under test (trailing slash required — see src/data/env.ts)
API_BASE_URL=https://practice.expandtesting.com/notes/api/

# Credentials for the static demo account on /login (public demo creds, not secret)
DEMO_USERNAME=practice
DEMO_PASSWORD=SuperSecretPassword!

# Basic/Digest auth practice pages (public demo creds, not secret)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin

# CI flag is set automatically by CircleCI; leave unset for local runs
CI=
